# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Get free 1,000 searches/month from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram Bot Token (Get free from BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (Send a message to your bot or use @userinfobot to find your ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
